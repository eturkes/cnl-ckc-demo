// Review probes rev-m1u4-2, round 2: c14 divergence naming, c18 static-predicate premise.
import { readFileSync, readdirSync } from 'node:fs';
import { createRequire } from 'node:module';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { beforeAll, describe, expect, it } from 'vitest';

import { BUDGET_MAX } from '../src/engine/budget.js';
import type { PlSolution } from '../src/engine/protocol.js';
import { EngineSession, type Engine, type ImageLoader } from '../src/engine/session.js';
import { QUESTION_CATALOG, type QuestionId } from '../src/questions/catalog.js';
import { serializeAnswer } from '../src/questions/serialize.js';
import { verifyBag } from '../tools/kb/bag.mjs';

const require = createRequire(import.meta.url);
const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const GENERATED = join(ROOT, 'kb', 'generated');
const read = (name: string): Buffer => readFileSync(join(GENERATED, name));
const manifest = JSON.parse(read('kb-manifest.json').toString('utf8')) as {
  contract: { schemaVersion: number; documents: number };
};
const ledger: string[] = [];
const note = (line: string): void => void ledger.push(line);
const diagnostics: string[] = [];
const drain = (): string[] => diagnostics.splice(0);
const loadImage: ImageLoader = async (image) => {
  const factory = require('swipl-wasm/dist/loadImageDefault.js') as
    | ((i: Uint8Array) => (o?: Record<string, unknown>) => Promise<Engine>)
    | { default: (i: Uint8Array) => (o?: Record<string, unknown>) => Promise<Engine> };
  const load = typeof factory === 'function' ? factory : factory.default;
  return load(image)({ printErr: (line: string) => diagnostics.push(line) });
};
const bagFiles = ((): Map<string, Uint8Array> => {
  const kb = join(ROOT, 'kb');
  const archive = readdirSync(kb).filter((n) => n.endsWith('.tar.gz'))[0] as string;
  return verifyBag(readFileSync(join(kb, archive))).files;
})();
const committedResult = (id: string): string => {
  const path = [...bagFiles.keys()].find((n) => n.endsWith(`/answers/${id}.pl`)) as string;
  const file = Buffer.from(bagFiles.get(path) as Uint8Array).toString('utf8');
  const open = file.indexOf('result(') + 'result('.length;
  let depth = 1;
  for (let i = open; i < file.length; i += 1) {
    if (file[i] === '(') depth += 1;
    else if (file[i] === ')') {
      depth -= 1;
      if (depth === 0) return file.slice(open, i);
    }
  }
  throw new Error('unbalanced');
};

const fresh = async (): Promise<EngineSession> => {
  const session = new EngineSession({ loadImage, drain, expected: manifest.contract });
  await session.boot(new Uint8Array(read('kb.pvm')));
  return session;
};
const solve = async (host: EngineSession, id: QuestionId): Promise<PlSolution[]> => {
  const out = await host.solve(QUESTION_CATALOG[id].goal, BUDGET_MAX, `p-${id}`);
  if (out.kind === 'solutions') return out.solutions;
  if (out.kind === 'failure') return [];
  throw new Error(`${id}: ${out.kind}`);
};

let base: EngineSession;
beforeAll(async () => {
  base = await fresh();
}, 120_000);

describe('round 2', () => {
  it('c14 reports each divergence by id and value', async () => {
    for (const id of ['dosage-reduction-content', 'evidence-type-1-recommendation'] as const) {
      const entry = QUESTION_CATALOG[id];
      const rows = await solve(base, id);
      const seed = rows[0] as PlSolution;
      const variable = entry.projection[0]?.variable as string;
      const injected: PlSolution[] = [
        ...rows,
        {
          bindings: { ...seed.bindings, [variable]: { kind: 'atom', value: 'zz-divergent' } },
          display: { ...seed.display, [variable]: 'zz-divergent' },
        },
      ];
      const live = serializeAnswer(entry, injected);
      let message = '<no assertion error>';
      try {
        expect(live).toBe(committedResult(id));
      } catch (error) {
        message = (error instanceof Error ? error.message : String(error)).replace(/\s+/gu, ' ');
      }
      note(
        `c14 ${id} projected=${variable} divergenceDetected=${message !== '<no assertion error>'} ` +
          `namesValue=${message.includes('zz-divergent')} msg=${message.slice(0, 120)}`,
      );
    }
    // A missing solution must also be named, not tolerated as "non-empty".
    const id: QuestionId = 'dosage-reduction-content';
    const rows = await solve(base, id);
    const short = serializeAnswer(QUESTION_CATALOG[id], rows.slice(0, 1));
    let missing = '<no assertion error>';
    try {
      expect(short).toBe(committedResult(id));
    } catch (error) {
      missing = (error instanceof Error ? error.message : String(error)).replace(/\s+/gu, ' ');
    }
    note(`c14 missing-solution detected=${missing !== '<no assertion error>'} msg=${missing.slice(0, 120)}`);
  }, 120_000);

  it('c18 checks whether dynamic/1 is required for the overlay', async () => {
    const marker = `rev2b-${process.pid}`;
    const entry = QUESTION_CATALOG['category-a-recommendations'];
    const gid = (n: number): string => `'$guideline_id'(product,'${marker}',${n},ref(1),[])`;
    const body =
      `guideline_entity(actual,${gid(1)},recommendation,countable).\n` +
      `guideline_cardinality(actual,${gid(1)},na,eq,1).\n` +
      `guideline_entity(actual,${gid(2)},'category-A-recommendation',countable).\n` +
      `guideline_cardinality(actual,${gid(2)},na,eq,1).\n` +
      `guideline_event(actual,${gid(3)},be).\n` +
      `guideline_arg(actual,${gid(3)},1,${gid(1)}).\n` +
      `guideline_arg(actual,${gid(3)},2,${gid(2)}).\n`;

    const bareSession = await fresh();
    const baseline = serializeAnswer(entry, await solve(bareSession, 'category-a-recommendations'));
    note(`c18b baselineRows=${baseline.split('sol([').length - 1} markerAbsent=${!baseline.includes(marker)}`);
    const bare = await bareSession.handle(
      { id: 'bare', kind: 'consult', source: body },
      new Uint8Array(read('kb.pvm')),
    );
    const afterBare = serializeAnswer(entry, await solve(bareSession, 'category-a-recommendations'));
    note(
      `c18b consultWithoutDynamic=${JSON.stringify(bare)} rows=${afterBare.split('sol([').length - 1} ` +
        `carriesMarker=${afterBare.includes(marker)} diagnostics=${JSON.stringify(diagnostics.slice(0, 2))}`,
    );

    const dynSession = await fresh();
    const dyn = await dynSession.handle(
      {
        id: 'dyn',
        kind: 'consult',
        source:
          ':- dynamic(guideline_entity/4).\n:- dynamic(guideline_cardinality/5).\n' +
          ':- dynamic(guideline_event/3).\n:- dynamic(guideline_arg/4).\n' +
          body,
      },
      new Uint8Array(read('kb.pvm')),
    );
    const afterDyn = serializeAnswer(entry, await solve(dynSession, 'category-a-recommendations'));
    note(
      `c18b consultWithDynamic=${JSON.stringify(dyn)} rows=${afterDyn.split('sol([').length - 1} carriesMarker=${afterDyn.includes(marker)}`,
    );
  }, 240_000);

  it('prints', () => {
    process.stdout.write(`\n@@LEDGER\n${ledger.join('\n')}\n@@END\n`);
    expect(ledger.length).toBeGreaterThan(0);
  });
});
