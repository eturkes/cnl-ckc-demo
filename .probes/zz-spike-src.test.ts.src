// c20/D9: replay wt/spike-m1u4-src c193a87's hand-written catalog against the
// shipped generated catalog. The SRC spike ships bag-verbatim prefix goals, so
// D4 predicts byte identity with the GEN-derived artifact.

import { readFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { describe, expect, it } from 'vitest';

import { QUESTION_CATALOG as SPIKE, QUESTION_IDS as SPIKE_IDS } from '../../spike/src-catalog.js';

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const shipped = JSON.parse(
  readFileSync(join(ROOT, 'kb', 'generated', 'question-catalog.json'), 'utf8'),
) as { entries: { id: string; goal: string; projection: { variable: string }[] }[] };
const byId = new Map(shipped.entries.map((entry) => [entry.id, entry]));

describe('spike-src differential', () => {
  it('declares the same six ids', () => {
    expect([...SPIKE_IDS].sort()).toEqual([...byId.keys()].sort());
  });

  it.each([...SPIKE_IDS])('ships %s byte-identically to the spike goal', (id) => {
    const spike = SPIKE[id] as {
      goal: string;
      projection: { variables: readonly { name: string }[] };
    };
    const mine = byId.get(id) as { goal: string; projection: { variable: string }[] };
    expect(mine.goal).toBe(spike.goal);
    expect(mine.projection.map((p) => p.variable)).toEqual(
      spike.projection.variables.map((v) => v.name),
    );
  });
});
