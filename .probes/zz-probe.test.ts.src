// Review probes rev-m1u4-2. Not a shipped test: it records adjudication evidence
// for rows c01-c03, c07-c11, c15-c17 and prints a machine-readable ledger.
import { readFileSync, readdirSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { describe, expect, it, vi } from 'vitest';

import { BUDGET_MAX } from '../src/engine/budget.js';
import type { EngineClient } from '../src/engine/client.js';
import type {
  BudgetSpec,
  EngineError,
  LimitKind,
  PlSolution,
} from '../src/engine/protocol.js';
import type { PlTerm } from '../src/engine/terms.js';
import {
  QUESTION_CATALOG,
  QUESTION_IDS,
  isQuestionId,
  type QuestionId,
} from '../src/questions/catalog.js';
import { humanizeGuidelineId } from '../src/questions/humanize.js';
import { compareTerms, serializeAnswer } from '../src/questions/serialize.js';
import { AnswerService } from '../src/questions/service.js';

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
const ledger: string[] = [];
const note = (line: string): void => void ledger.push(line);

type Outcome = Awaited<ReturnType<EngineClient['query']>>;
const fakeClient = (
  outcome: Outcome | (() => Outcome),
): { client: EngineClient; calls: { goal: string; budget: BudgetSpec }[] } => {
  const calls: { goal: string; budget: BudgetSpec }[] = [];
  const client = {
    query: vi.fn(async (goal: string, budget: BudgetSpec) => {
      calls.push({ goal, budget });
      return typeof outcome === 'function' ? outcome() : outcome;
    }),
  } as unknown as EngineClient;
  return { client, calls };
};

const atom = (value: string): PlTerm => ({ kind: 'atom', value });
const sol = (bindings: Record<string, PlTerm>, display: Record<string, string>): PlSolution => ({
  bindings,
  display,
});
const gid = (doc: string, sentence: number): PlTerm => ({
  kind: 'compound',
  functor: '$guideline_id',
  args: [
    atom('product'),
    atom(doc),
    { kind: 'integer', value: sentence },
    { kind: 'compound', functor: 'ref', args: [{ kind: 'integer', value: 1 }] },
    { kind: 'list', items: [] },
  ],
});

describe('c01 catalog shape', () => {
  it('exposes six frozen entries on a null-prototype record', () => {
    note(`c01 ids=${QUESTION_IDS.length} keys=${Object.keys(QUESTION_CATALOG).length}`);
    note(`c01 prototype=${String(Object.getPrototypeOf(QUESTION_CATALOG))}`);
    note(`c01 frozenRoot=${Object.isFrozen(QUESTION_CATALOG)}`);
    note(
      `c01 frozenEntries=${QUESTION_IDS.every((id) => Object.isFrozen(QUESTION_CATALOG[id]) && Object.isFrozen(QUESTION_CATALOG[id].projection))}`,
    );
    const hostile = ['__proto__', 'constructor', 'toString', 'hasOwnProperty', 'valueOf'];
    const reachable = hostile.filter(
      (key) => (QUESTION_CATALOG as unknown as Record<string, unknown>)[key] !== undefined,
    );
    note(`c01 prototypeKeysReachable=${JSON.stringify(reachable)}`);
    // Computed access: the id is assembled at runtime, not written as a literal.
    const computed = ['category', 'a', 'recommendations'].join('-') as QuestionId;
    note(`c01 computedLookupResolves=${QUESTION_CATALOG[computed]?.id === computed}`);
    note(`c01 idsSorted=${JSON.stringify([...QUESTION_IDS]) === JSON.stringify([...QUESTION_IDS].sort())}`);
    expect(Object.keys(QUESTION_CATALOG)).toHaveLength(6);
  });
});

describe('c02 rejection corpus, spy-backed', () => {
  it('rejects every non-id with one typed variant and never reaches the engine', async () => {
    const corpus: unknown[] = [
      'no-such-question',
      '',
      ' ',
      '\t\n ',
      'Which recommendation is a category-A-recommendation?',
      "guideline_entity(actual,A,recommendation,countable).",
      "','(guideline_entity(actual,A,recommendation,countable),true)",
      'true',
      'halt.',
      'Category-A-Recommendations',
      'CATEGORY-A-RECOMMENDATIONS',
      'category-a-recommendations.',
      ' category-a-recommendations',
      'category-a-recommendations ',
      '__proto__',
      'constructor',
      'prototype',
      'toString',
      42,
      null,
      undefined,
      {},
      [],
      Symbol('category-a-recommendations'),
      new String('category-a-recommendations'),
    ];
    const { client, calls } = fakeClient({ kind: 'solutions', solutions: [] });
    const service = new AnswerService(client);
    const shapes = new Set<string>();
    for (const value of corpus) {
      const result = await service.ask(value, BUDGET_MAX);
      shapes.add(JSON.stringify(result));
    }
    note(`c02 corpus=${corpus.length} distinctResults=${JSON.stringify([...shapes])}`);
    note(`c02 engineCalls=${calls.length}`);
    expect(calls).toHaveLength(0);
    expect(shapes.size).toBe(1);
  });
});

describe('c03 entry structure', () => {
  it('carries goal, projection and provenance per entry, none derived from text', () => {
    for (const id of QUESTION_IDS) {
      const entry = QUESTION_CATALOG[id];
      note(
        `c03 ${id} goalBytes=${Buffer.byteLength(entry.goal)} proj=${entry.projection.length} prov=${entry.provenance} ` +
          `goalHasQuestionText=${entry.goal.includes(entry.question)} questionInGoal=${entry.goal.includes('?')}`,
      );
    }
  });
});

describe('c07 budget surface', () => {
  it('passes the caller budget through untouched and never mints one', async () => {
    const { client, calls } = fakeClient({ kind: 'solutions', solutions: [] });
    const service = new AnswerService(client);
    const budget: BudgetSpec = { ...BUDGET_MAX, answerCap: 3 };
    await service.ask('category-a-recommendations', budget);
    note(`c07 forwardedGoalIsCatalogGoal=${calls[0]?.goal === QUESTION_CATALOG['category-a-recommendations'].goal}`);
    note(`c07 forwardedBudgetIdentical=${calls[0]?.budget === budget}`);
  });

  it('propagates a budget rejection as a typed error rather than a bare result', async () => {
    const { client } = fakeClient({
      kind: 'error',
      error: { code: 'budget', message: 'answerCap must be a positive integer' },
    });
    const service = new AnswerService(client);
    const result = await service.ask('category-a-recommendations', {} as BudgetSpec);
    note(`c07 invalidBudgetResult=${JSON.stringify(result)}`);
  });
});

describe('c08 live-DTO derivation', () => {
  it('renders the injected DTO, not the committed fixture', async () => {
    const kb = join(ROOT, 'kb');
    const archive = readdirSync(kb).filter((n) => n.endsWith('.tar.gz'))[0] as string;
    note(`c08 bagPresentForTests=${archive.length > 0}`);
    const fabricated = sol({ A: gid('probe-doc', 9) }, { A: "'$guideline_id'(product,'probe-doc',9,ref(1),[])" });
    const { client } = fakeClient({ kind: 'solutions', solutions: [fabricated] });
    const result = await new AnswerService(client).ask('category-a-recommendations', BUDGET_MAX);
    const serialized = result.kind === 'answer' ? result.serialized : `<${result.kind}>`;
    note(`c08 serializedFromInjectedDto=${serialized}`);
    expect(serialized).toContain('probe-doc');
  });
});

describe('c09 terminal-state fidelity', () => {
  it('maps every engine outcome to its own AnswerResult kind', async () => {
    const limits: LimitKind[] = ['stack', 'depth', 'inference', 'wall-clock', 'answer-cap', 'heap'];
    const codes = ['boot', 'contract', 'prolog', 'decode', 'protocol', 'worker', 'budget', 'consult'] as const;
    const cases: [string, Outcome][] = [
      ['solutions-empty', { kind: 'solutions', solutions: [] }],
      ['failure', { kind: 'failure' }],
      ['cancelled', { kind: 'cancelled', solutions: [] }],
      ...limits.map((limit): [string, Outcome] => [
        `limit:${limit}`,
        { kind: 'limit', limit, solutions: [] },
      ]),
      ...codes.map((code): [string, Outcome] => [
        `error:${code}`,
        { kind: 'error', error: { code, message: code } as EngineError },
      ]),
    ];
    const rows: string[] = [];
    for (const [label, outcome] of cases) {
      const { client } = fakeClient(outcome);
      const result = await new AnswerService(client).ask('category-a-recommendations', BUDGET_MAX);
      const tag =
        result.kind === 'limit'
          ? `limit/${result.limit}`
          : result.kind === 'error'
            ? `error/${result.error.code}`
            : result.kind;
      rows.push(`${label}->${tag}`);
    }
    note(`c09 ${rows.join(' ')}`);
    note(`c09 distinctTags=${new Set(rows.map((r) => r.split('->')[1])).size} of ${cases.length}`);
    // An honest zero-solution run must not read as a limit or an error.
    const { client } = fakeClient({ kind: 'failure' });
    const failure = await new AnswerService(client).ask('recommendation-exists', BUDGET_MAX);
    note(`c09 honestZeroSerialized=${failure.kind === 'failure' ? failure.serialized : failure.kind}`);
  });
});

describe('c10 existence rendering', () => {
  it('renders yes/no and never an empty row list', () => {
    const entry = QUESTION_CATALOG['recommendation-exists'];
    note(`c10 projectionLength=${entry.projection.length}`);
    const twelve = Array.from({ length: 12 }, () => sol({}, {}));
    note(`c10 twelveProofs=${serializeAnswer(entry, twelve)}`);
    note(`c10 zeroProofs=${serializeAnswer(entry, [])}`);
    note(`c10 oneProof=${serializeAnswer(entry, [sol({}, {})])}`);
    const rows = QUESTION_CATALOG['category-a-recommendations'];
    note(`c10 nonExistenceEmpty=${serializeAnswer(rows, [])}`);
  });
});

describe('c11 projection discipline', () => {
  it('drops undeclared bindings and keeps engine text verbatim', () => {
    const entry = QUESTION_CATALOG['category-a-recommendations'];
    const extra = sol(
      { A: gid('doc-1', 3), B: atom('leak'), Secret: atom('leak2') },
      { A: "'$guideline_id'(product,'doc-1',3,ref(1),[])", B: 'leak', Secret: 'leak2' },
    );
    const out = serializeAnswer(entry, [extra]);
    note(`c11 undeclaredLeak=${out.includes('leak')} out=${out}`);
    // Rational trap: `1r3` round-trips as `3r1` through JSON.stringify.
    const rational: PlTerm = { kind: 'rational', numerator: 1, denominator: 3 };
    note(`c11 rationalJsonStringify=${JSON.stringify(rational)}`);
    note(`c11 rationalDisplayPreserved=${serializeAnswer(entry, [sol({ A: rational }, { A: '1r3' })])}`);
    // Guideline compound trap: arity-5 compound must not be reshaped.
    note(
      `c11 compoundDisplayPreserved=${serializeAnswer(entry, [sol({ A: gid('doc-1', 3) }, { A: "'$guideline_id'(product,'doc-1',3,ref(1),[])" })])}`,
    );
  });

  it('throws rather than emitting a hole when a declared variable is unbound', () => {
    const entry = QUESTION_CATALOG['category-a-recommendations'];
    let message = 'no throw';
    try {
      serializeAnswer(entry, [sol({ Z: atom('x') }, { Z: 'x' })]);
    } catch (error) {
      message = error instanceof Error ? error.message : String(error);
    }
    note(`c11 missingDeclaredVariable="${message}"`);
  });
});

describe('c12 order property corpus', () => {
  it('agrees with SWI standard order where a byte sort disagrees', () => {
    const entry = QUESTION_CATALOG['category-a-recommendations'];
    // Sentence 2 vs 10 under one document id: term order 2<10, byte order '10'<'2'.
    const mixed: PlSolution[] = [10, 2, 1].map((n) =>
      sol({ A: gid('doc-1', n) }, { A: `'$guideline_id'(product,'doc-1',${n},ref(1),[])` }),
    );
    const termOrder = serializeAnswer(entry, mixed);
    const byteOrder = `solutions([${[...mixed]
      .map((s) => `sol([${s.display['A'] as string}])`)
      .sort()
      .join(',')}])`;
    note(`c12 termOrder=${termOrder}`);
    note(`c12 byteOrder=${byteOrder}`);
    note(`c12 divergent=${termOrder !== byteOrder}`);
    // Mixed shapes: atom vs number vs compound vs string vs list.
    const shapes: PlTerm[] = [
      { kind: 'compound', functor: 'f', args: [atom('a')] },
      atom('zzz'),
      { kind: 'integer', value: 100 },
      { kind: 'string', value: 'aaa' },
      { kind: 'variable', id: 7 },
      { kind: 'list', items: [atom('a')] },
      { kind: 'float', value: 2 },
      { kind: 'rational', numerator: 5, denominator: 2 },
      { kind: 'integer', value: 2 },
    ];
    const sorted = [...shapes].sort(compareTerms).map((t) => t.kind);
    note(`c12 mixedShapeOrder=${JSON.stringify(sorted)}`);
    // Totality: no two distinct shapes compare equal.
    const ties: string[] = [];
    for (const [i, a] of shapes.entries())
      for (const [j, b] of shapes.entries())
        if (i !== j && compareTerms(a, b) === 0) ties.push(`${i}/${j}`);
    note(`c12 tiesAmongDistinct=${JSON.stringify(ties)}`);
    // Antisymmetry + transitivity spot-check over the corpus.
    const asym = shapes.every((a) =>
      shapes.every((b) => Math.sign(compareTerms(a, b)) === -Math.sign(compareTerms(b, a))),
    );
    note(`c12 antisymmetric=${asym}`);
    // Permutation invariance of the serializer over a mixed corpus.
    const perms = [mixed, [...mixed].reverse(), [mixed[1], mixed[2], mixed[0]] as PlSolution[]];
    note(`c12 permutationInvariant=${new Set(perms.map((p) => serializeAnswer(entry, p))).size === 1}`);
    // Duplicate proofs collapse (sort/2 semantics).
    note(`c12 duplicatesCollapse=${serializeAnswer(entry, [mixed[0] as PlSolution, mixed[0] as PlSolution])}`);
  });
});

describe('c15 grammar', () => {
  it('emits sol([...]) inside solutions([...]) using engine display text only', () => {
    const entry = QUESTION_CATALOG['category-a-recommendations'];
    const trap = "weird'text\\with,commas";
    const out = serializeAnswer(entry, [sol({ A: atom('x') }, { A: trap })]);
    note(`c15 verbatimDisplay=${out}`);
    note(`c15 grammarShape=${/^solutions\(\[sol\(\[.*\]\)\]\)$/su.test(out)}`);
    note(`c15 displayUsedNotTerm=${out.includes(trap)}`);
  });
});

describe('c16/c17 humanizer', () => {
  it('formats structurally and degrades to engine text', () => {
    const cases: [string, PlTerm][] = [
      ['product/ref', gid('cdc2022-opioid-rec01', 1)],
      [
        'context/box',
        {
          kind: 'compound',
          functor: '$guideline_id',
          args: [
            atom('context'),
            atom('other-corpus-doc'),
            { kind: 'integer', value: 25 },
            { kind: 'compound', functor: 'box', args: [{ kind: 'integer', value: 9 }] },
            { kind: 'list', items: [atom('dep')] },
          ],
        },
      ],
      ['no-hyphen doc id', gid('plaindoc', 1)],
      [
        'non-atom doc id',
        {
          kind: 'compound',
          functor: '$guideline_id',
          args: [
            atom('product'),
            { kind: 'integer', value: 7 },
            { kind: 'integer', value: 1 },
            { kind: 'compound', functor: 'ref', args: [{ kind: 'integer', value: 1 }] },
            { kind: 'list', items: [] },
          ],
        },
      ],
      [
        'wrong arity',
        { kind: 'compound', functor: '$guideline_id', args: [atom('product'), atom('d')] },
      ],
      [
        'wrong functor',
        {
          kind: 'compound',
          functor: 'guideline_id',
          args: [
            atom('product'),
            atom('d'),
            { kind: 'integer', value: 1 },
            { kind: 'compound', functor: 'ref', args: [{ kind: 'integer', value: 1 }] },
            { kind: 'list', items: [] },
          ],
        },
      ],
      [
        'locator arity 2',
        {
          kind: 'compound',
          functor: '$guideline_id',
          args: [
            atom('product'),
            atom('d'),
            { kind: 'integer', value: 1 },
            { kind: 'compound', functor: 'ref', args: [{ kind: 'integer', value: 1 }, atom('x')] },
            { kind: 'list', items: [] },
          ],
        },
      ],
      [
        'sentence not integer',
        {
          kind: 'compound',
          functor: '$guideline_id',
          args: [
            atom('product'),
            atom('d'),
            atom('one'),
            { kind: 'compound', functor: 'ref', args: [{ kind: 'integer', value: 1 }] },
            { kind: 'list', items: [] },
          ],
        },
      ],
      ['atom', atom('plain')],
      ['string', { kind: 'string', value: 'plain' }],
      ['variable', { kind: 'variable', id: 1 }],
      ['list', { kind: 'list', items: [] }],
    ];
    for (const [label, term] of cases) {
      let out = '<threw>';
      try {
        out = humanizeGuidelineId(term, 'ENGINE-TEXT');
      } catch (error) {
        out = `<threw ${error instanceof Error ? error.message : String(error)}>`;
      }
      note(`c16 ${label} => ${out}`);
    }
  });

  it('keeps the label out of every byte the serializer emits', () => {
    const entry = QUESTION_CATALOG['category-a-recommendations'];
    const term = gid('cdc2022-opioid-rec01', 3);
    const display = "'$guideline_id'(product,'cdc2022-opioid-rec01',3,ref(1),[])";
    const label = humanizeGuidelineId(term, display);
    const out = serializeAnswer(entry, [sol({ A: term }, { A: display })]);
    note(`c17 label=${label}`);
    note(`c17 labelInSerialized=${out.includes(label)}`);
    note(`c17 serializedEqualsDisplayGrammar=${out === `solutions([sol([${display}])])`}`);
    // A label-shaped display must not change the sort key either.
    const a = gid('doc-b', 1);
    const b = gid('doc-a', 1);
    const withLabels = serializeAnswer(entry, [
      sol({ A: a }, { A: 'zzz-display-for-doc-b' }),
      sol({ A: b }, { A: 'aaa-display-for-doc-a' }),
    ]);
    note(`c17 sortKeyIsTermNotDisplay=${withLabels === 'solutions([sol([aaa-display-for-doc-a]),sol([zzz-display-for-doc-b])])'} out=${withLabels}`);
  });
});

describe('ledger', () => {
  it('prints', () => {
    process.stdout.write(`\n@@LEDGER\n${ledger.join('\n')}\n@@END\n`);
    expect(ledger.length).toBeGreaterThan(0);
  });
});
