{
  "name": "cnl-ckc-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0 WITH LLVM-exception",
  "description": "Demo: deterministic Prolog queries over the cnl-ckc clinical knowledge base, answered in the browser.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "audit:check": "pnpm audit --audit-level=moderate",
    "binding:check": "node tools/binding-check.mjs",
    "binding:replay": "node tools/binding-replay.mjs",
    "browser:check": "node tools/browser-check.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "contrast:check": "node tools/contrast.mjs",
    "copy:check": "node tools/copy-check.mjs",
    "dev": "vite",
    "engine:check": "node tools/engine-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "pnpm audit:check && pnpm secret:check && pnpm kb:build && pnpm kb:asset-check && pnpm kb:export-check && pnpm engine:check && pnpm copy:check && pnpm contrast:check && pnpm presentation:check && pnpm format:check && pnpm lint && pnpm check && pnpm binding:check && pnpm build",
    "graph:check": "node tools/graph-check.mjs",
    "kb:asset-check": "node tools/kb/check.mjs",
    "kb:export-check": "node tools/kb/export-check.mjs",
    "kb:build": "node tools/kb/build.mjs",
    "kb:reproduce": "node tools/kb/reproduce.mjs",
    "lint": "eslint . --max-warnings=0",
    "presentation:check": "node tools/presentation-check.mjs",
    "preview": "vite preview",
    "release:check": "pnpm gate && pnpm kb:reproduce && pnpm smoke && pnpm browser:check && pnpm graph:check",
    "secret:check": "node tools/secret-check.mjs",
    "smoke": "node tools/smoke.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/biz-udpgothic": "5.3.0",
    "cytoscape": "3.34.2",
    "cytoscape-fcose": "2.2.0",
    "swipl-wasm": "8.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^12.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "secretlint": "^12.3.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
