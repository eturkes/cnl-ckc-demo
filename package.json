{
  "name": "cnl-ckc-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0 WITH LLVM-exception",
  "description": "Demo: deterministic Prolog queries over the cnl-ckc clinical knowledge base, answered in the browser.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "audit:check": "pnpm audit --audit-level=moderate",
    "binding:check": "node tools/binding-check.mjs",
    "binding:replay": "node tools/binding-replay.mjs",
    "browser:check": "node tools/browser-check.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "contrast:check": "node tools/contrast.mjs",
    "copy:check": "node tools/copy-check.mjs",
    "dev": "vite",
    "engine:check": "node tools/engine-check.mjs",
    "engine:probe": "node tools/engine-probe.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "pnpm audit:check && pnpm secret:check && pnpm kb:build && pnpm kb:asset-check && pnpm kb:export-check && pnpm engine:check && pnpm copy:check && pnpm contrast:check && pnpm presentation:check && pnpm claims:check && pnpm format:check && pnpm lint && pnpm check && pnpm binding:check && pnpm build",
    "graph:check": "node tools/graph-check.mjs",
    "intake:dev": "WRANGLER_SEND_METRICS=false wrangler dev",
    "intake:live": "node tools/intake-live.mjs",
    "intake:probe": "node tools/intake-probe.mjs && INTAKE_REPORT_WRITE=1 vitest run tests/intake-replay.test.ts && prettier --write tests/intake/replay.json tests/intake/report.json",
    "kb:asset-check": "node tools/kb/check.mjs",
    "kb:export-check": "node tools/kb/export-check.mjs",
    "kb:build": "node tools/kb/build.mjs",
    "kb:reproduce": "node tools/kb/reproduce.mjs",
    "lint": "eslint . --max-warnings=0",
    "mutate": "node tools/mutate.mjs",
    "presentation:check": "node tools/presentation-check.mjs",
    "font:subset": "node tools/font-subset.mjs",
    "visual-qa": "node tools/visual-qa.mjs",
    "readme:check": "node tools/readme-check.mjs",
    "claims:check": "node tools/claims-sweep.mjs",
    "claims:seed": "node tools/claims-sweep.mjs --seed",
    "preview": "vite preview",
    "release:check": "pnpm gate && pnpm kb:reproduce && pnpm smoke && pnpm browser:check && pnpm graph:check && pnpm readme:check && pnpm test:browser && pnpm engine:probe",
    "secret:check": "node tools/secret-check.mjs",
    "smoke": "node tools/smoke.mjs",
    "test": "vitest run",
    "test:browser": "node tools/browser-tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/biz-udpgothic": "5.3.0",
    "@typesafe-ai/sdk": "0.6.0",
    "cytoscape": "3.34.2",
    "cytoscape-fcose": "2.2.0",
    "swipl-wasm": "8.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-svelte": "^3.23.0",
    "fontverter": "2.0.0",
    "globals": "^17.11.0",
    "harfbuzzjs": "1.6.2",
    "jsdom": "^30.1.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "secretlint": "^13.0.6",
    "subset-font": "2.9.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.28.0 <7.29.1": "^7.29.1"
    }
  }
}
