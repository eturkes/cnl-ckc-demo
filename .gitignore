# Dependencies. No trailing slash: worktrees reach the toolchain through a symlink.
node_modules

# Generated runtime payload: rebuilt from the vendored bag by `pnpm kb:build`.
kb/generated/

# Build output (Vite) + tool caches
dist/
coverage/
*.tsbuildinfo
.vite/

# Agent scratch + machine-local overrides
.scratch/
.claude/settings.local.json
.claude/.headroom_wrap_marker.json
CLAUDE.local.md
