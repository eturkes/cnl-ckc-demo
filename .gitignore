# Dependencies. No trailing slash: a `node_modules` symlink stays ignored too.
node_modules

# Generated runtime payload: rebuilt from the vendored bag by `pnpm kb:build`.
kb/generated

# Build output (Vite) + tool caches
dist/
*.tsbuildinfo
.vite/

# `pnpm stryker`: its sandbox while a run lasts, then its HTML + JSON reports.
.stryker-tmp/
reports/

# Visual-QA walker output: PNGs regenerated by the probe on `wt/map-m1u7`.
.probe/

# The retired judgment proxy's local key file: still ignored, so a stale key never reaches a
# commit.
.dev.vars

# Agent scratch + machine-local overrides
.scratch/
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# vitest browser-mode failure screenshots
.vitest-attachments
tests/__screenshots__

# Prototype seams: derived from the vendored bag by each prototype's own derive script.
prototype/*/generated/
prototype/*/variants/*/generated/

# Local credentials + OS/editor debris; checked-in environment examples remain visible.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.log
