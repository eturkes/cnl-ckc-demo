# Dependencies. No trailing slash: worktrees reach the toolchain through a symlink.
node_modules

# Generated runtime payload: rebuilt from the vendored bag by `pnpm kb:build`.
# No trailing slash: worktrees reach the payload through a symlink, and the slash
# form matches directories only, which would leave that symlink untracked-visible.
kb/generated

# Build output (Vite) + tool caches
dist/
*.tsbuildinfo
.vite/

# Visual-QA walker output: PNGs regenerated by the probe on `wt/map-m1u7`.
.probe/

# Agent scratch + machine-local overrides
.scratch/
.claude/settings.local.json
.claude/.headroom_wrap_marker.json
CLAUDE.local.md
