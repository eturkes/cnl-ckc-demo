exports[`undated prepared answers > C1 continuing-or-tapering-opioids keeps canonical bytes and statement order 1`] = `
{
  "canonical": "7b609779eb633a81c305ab2c13d569f52767de63c0526566819160717a3259d3",
  "points": [
    {
      "sources": [
        0,
      ],
      "text": "If a patient receives opioid therapy, clinicians should carefully weigh a benefit against a risk for the patient.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a clinician changes opioid dosage for a patient that receives opioid therapy, the clinician should carefully change the opioid dosage.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient receives opioid therapy and the opioid therapy has a benefit and has a risk and the benefit outweighs the risk, clinicians should closely work with the patient, optimize nonopioid therapy, and continue the opioid therapy.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient receives opioid therapy and the opioid therapy has a benefit and has a risk and the benefit does not outweigh the risk, clinicians should optimize different therapy, closely work with the patient, and gradually taper opioid dosage to lower opioid dosage.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient receives opioid therapy and the opioid therapy has a benefit and has a risk and the benefit does not outweigh the risk and the patient takes an opioid and opioid discontinuation is warranted for the patient, clinicians should appropriately taper the opioid and appropriately discontinue the opioid.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If there is a clinician that does not provably detect life threatening warning, the clinician should not abruptly discontinue an opioid.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If there is a clinician that does not provably detect life threatening warning, the clinician should not rapidly reduce opioid dosage from higher dosage.",
    },
    {
      "sources": [
        0,
      ],
      "text": "A life threatening warning example is impending overdose warning sign example.",
    },
    {
      "sources": [
        0,
      ],
      "text": "An impending overdose warning sign example includes confusion example, includes sedation example, and includes slurred speech example.",
    },
  ],
}
`;

exports[`undated prepared answers > C1 opioid-follow-up keeps canonical bytes and statement order 1`] = `
{
  "canonical": "e8bc7d9d2a37ebb380f87d2d0316e482c3f7997fcfb48db21967efa8f889fa2b",
  "points": [
    {
      "sources": [
        0,
      ],
      "text": "Clinicians should evaluate opioid benefit with a patient after at least 1 week of therapy start within at most 4 weeks of the therapy start for subacute pain and evaluate opioid risk with a patient after at least 1 week of therapy start within at most 4 weeks of the therapy start for subacute pain.",
    },
    {
      "sources": [
        0,
      ],
      "text": "Clinicians should evaluate opioid benefit with a patient after at least 1 week of therapy start within at most 4 weeks of the therapy start for chronic pain and evaluate opioid risk with a patient after at least 1 week of therapy start within at most 4 weeks of the therapy start for chronic pain.",
    },
    {
      "sources": [
        0,
      ],
      "text": "Clinicians should evaluate opioid benefit with a patient after at least 1 week of dosage escalation within at most 4 weeks of the dosage escalation and evaluate opioid risk with a patient after at least 1 week of dosage escalation within at most 4 weeks of the dosage escalation.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient continues opioid therapy, clinicians should regularly reevaluate opioid benefit with the patient and regularly reevaluate opioid risk with the patient.",
    },
  ],
}
`;

exports[`undated prepared answers > C1 opioid-safety keeps canonical bytes and statement order 1`] = `
{
  "canonical": "73d09c1f0138dd96db46eb3715125ff413658939977eaa0e66f42bcdfcb6318e",
  "points": [
    {
      "sources": [
        0,
      ],
      "text": "Clinicians should evaluate a risk for opioid related harm before opioid initiation and discuss a risk for opioid related harm with a patient before opioid initiation.",
    },
    {
      "sources": [
        0,
      ],
      "text": "Clinicians should periodically evaluate a risk for opioid related harm during continued opioid therapy and periodically discuss a risk for opioid related harm with a patient during continued opioid therapy.",
    },
    {
      "sources": [
        0,
      ],
      "text": "Clinicians should incorporate risk mitigation strategy in management plan with a patient and offer naloxone dose.",
    },
    {
      "sources": [
        1,
      ],
      "text": "When any applies — a clinician prescribes initial opioid therapy to a patient for acute pain, a clinician prescribes initial opioid therapy to a patient for subacute pain, or a clinician prescribes initial opioid therapy to a patient for chronic pain — the clinician should review controlled substance prescription history for the patient with state PDMP record, assess the patient for high overdose risk from opioid dosage, and assess the patient for high overdose risk from medication combination.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient receives chronic opioid therapy, clinicians should periodically review controlled substance prescription history for the patient with state PDMP record during the chronic opioid therapy, periodically assess the patient for high overdose risk from opioid dosage, and periodically assess the patient for high overdose risk from medication combination.",
    },
    {
      "sources": [
        2,
      ],
      "text": "When any applies — a clinician prescribes an opioid for subacute pain or a clinician prescribes an opioid for chronic pain — the clinician should consider testing benefit and consider testing risk.",
    },
    {
      "sources": [
        2,
      ],
      "text": "Every toxicology testing can assess prescribed medication, assess prescribed controlled substance, and assess nonprescribed controlled substance.",
    },
    {
      "sources": [
        3,
      ],
      "text": "If a clinician prescribes opioid pain medication with a benzodiazepine, the clinician should particularly prescribe the opioid pain medication with the benzodiazepine cautiously.",
    },
    {
      "sources": [
        3,
      ],
      "text": "If a clinician prescribes an opioid with central nervous system depressant, the clinician should weigh a benefit against a risk.",
    },
  ],
}
`;

exports[`undated prepared answers > C1 opioid-use-disorder-treatment keeps canonical bytes and statement order 1`] = `
{
  "canonical": "765a9d618c8d589906aa02732a6ceb27cc440a7738c1d79ea9b9a80cd445bd14",
  "points": [
    {
      "sources": [
        0,
      ],
      "text": "If a patient has opioid use disorder, clinicians should offer evidence based medication treatment for the opioid use disorder to the patient.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient has opioid use disorder and there is a clinician, the clinician should not use medication free detoxification for the patient.",
    },
    {
      "sources": [
        0,
      ],
      "text": "Every medication free detoxification increases a risk for drug use resumption, increases a risk for an overdose, and increases a risk for overdose death.",
    },
  ],
}
`;

exports[`undated prepared answers > C1 starting-opioid-therapy keeps canonical bytes and statement order 1`] = `
{
  "canonical": "c8b320c060c364f0581e37c7de9cdd5a967e574e34607d5c3559521595de98dc",
  "points": [
    {
      "sources": [
        0,
      ],
      "text": "When any applies — a clinician starts opioid therapy for acute pain, a clinician starts opioid therapy for subacute pain, or a clinician starts opioid therapy for chronic pain — the clinician should prescribe immediate release opioid instead of ER LA opioid.",
    },
    {
      "sources": [
        1,
      ],
      "text": "When any applies — a clinician starts opioid therapy for opioid naive patient that has acute pain, a clinician starts opioid therapy for opioid naive patient that has subacute pain, or a clinician starts opioid therapy for opioid naive patient that has chronic pain — the clinician should prescribe lowest effective dosage.",
    },
    {
      "sources": [
        1,
      ],
      "text": "When any applies — a clinician continues opioid therapy for subacute pain and the clinician prescribes an opioid at a dosage or a clinician continues opioid therapy for chronic pain and the clinician prescribes an opioid at a dosage — the clinician should prescribe the opioid cautiously at the dosage.",
    },
    {
      "sources": [
        1,
      ],
      "text": "When any applies — a clinician continues opioid therapy for subacute pain and the clinician considers dosage increase or a clinician continues opioid therapy for chronic pain and the clinician considers dosage increase — the clinician should carefully evaluate individual benefit and carefully evaluate individual risk.",
    },
    {
      "sources": [
        1,
      ],
      "text": "When any applies — a clinician continues opioid therapy for subacute pain or a clinician continues opioid therapy for chronic pain — the clinician should not increase opioid dosage above dosage level that likely yields diminishing patient benefit relative to risk return.",
    },
  ],
}
`;

exports[`undated prepared answers > C1 when-to-use-opioids keeps canonical bytes and statement order 1`] = `
{
  "canonical": "ddad3c9df39aef53f2b96d97943436ceb8f8a8222a10e0f109e585e132c16dba",
  "points": [
    {
      "sources": [
        0,
      ],
      "text": "Every nonopioid therapy shows at least opioid equal common acute pain effectiveness.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient has acute pain and nonpharmacologic therapy is appropriate for the acute pain and is appropriate for the patient, clinicians should maximize the nonpharmacologic therapy for the acute pain.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient has acute pain and nonopioid pharmacologic therapy is appropriate for the acute pain and is appropriate for the patient, clinicians should maximize the nonopioid pharmacologic therapy for the acute pain.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient has acute pain and opioid benefit does not likely outweigh opioid risk for the patient and there is a clinician, the clinician should not consider opioid therapy for the acute pain.",
    },
    {
      "sources": [
        0,
      ],
      "text": "If a patient has acute pain and a clinician considers opioid prescription for the acute pain, the clinician should discuss realistic benefit with the patient before the opioid prescription and discuss known risk with the patient before the opioid prescription.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has subacute pain, every nonopioid therapy is preferred for the subacute pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has chronic pain, every nonopioid therapy is preferred for the chronic pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has subacute pain and nonpharmacologic therapy is appropriate for the subacute pain and is appropriate for the patient, clinicians should maximize the nonpharmacologic therapy for the subacute pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has subacute pain and nonopioid pharmacologic therapy is appropriate for the subacute pain and is appropriate for the patient, clinicians should maximize the nonopioid pharmacologic therapy for the subacute pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has chronic pain and nonpharmacologic therapy is appropriate for the chronic pain and is appropriate for the patient, clinicians should maximize the nonpharmacologic therapy for the chronic pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has chronic pain and nonopioid pharmacologic therapy is appropriate for the chronic pain and is appropriate for the patient, clinicians should maximize the nonopioid pharmacologic therapy for the chronic pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has subacute pain and expected pain and function opioid benefit does not likely outweigh opioid risk for the patient and there is a clinician, the clinician should not consider opioid therapy initiation for the subacute pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "If a patient has chronic pain and expected pain and function opioid benefit does not likely outweigh opioid risk for the patient and there is a clinician, the clinician should not consider opioid therapy initiation for the chronic pain.",
    },
    {
      "sources": [
        1,
      ],
      "text": "When any applies — a patient has subacute pain and a clinician considers opioid therapy initiation for the subacute pain or a patient has chronic pain and a clinician considers opioid therapy initiation for the chronic pain — the clinician should discuss realistic benefit with the patient before the opioid therapy initiation and discuss known risk with the patient before the opioid therapy initiation.",
    },
    {
      "sources": [
        1,
      ],
      "text": "When any applies — a patient has subacute pain and a clinician considers opioid therapy initiation for the subacute pain or a patient has chronic pain and a clinician considers opioid therapy initiation for the chronic pain — the clinician should establish pain goal with the patient before the opioid therapy initiation, establish function goal with the patient before the opioid therapy initiation, and consider insufficient benefit discontinuation plan before the opioid therapy initiation.",
    },
  ],
}
`;

